# Application
APP_URL=http://localhost:3000
NODE_ENV=development
INTEGRATIONS_MODE=fake

# Database (PostgreSQL 16)
DATABASE_URL=postgres://fnpl:fnpl@localhost:5432/fnpl
DATABASE_URL_UNPOOLED=postgres://fnpl:fnpl@localhost:5432/fnpl

# Authentication (Better Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-32-byte-base64-secret
BETTER_AUTH_URL=http://localhost:3000

# Field-level encryption (32-byte base64 key for national IDs)
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=change-me-generate-32-byte-base64-key

# Email (Resend; local fake mode sends to Mailpit SMTP)
RESEND_API_KEY=
EMAIL_FROM=Ask AutoParts <no-reply@mail.askautoparts.africa>
EMAIL_REPLY_TO=mycar@askautoparts.africa
RESEND_WEBHOOK_SECRET=
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=ASKAUTOPARTS

# WhatsApp (Meta Cloud API, phase 9)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Payments (Safaricom Daraja - fee only: KES 1,500)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=880100
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=local-dev-mpesa-secret

# Object storage (S3 or Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=fnpl-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Bot protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PDF rendering service (if separate from in-process)
PDF_RENDERER_URL=
PDF_RENDERER_TOKEN=
